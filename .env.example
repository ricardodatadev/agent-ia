# =====================================================================
# LLM — escolha UM provedor/modelo (ADR-12 e ADR-13 em spec-driven/SPEC.md)
# =====================================================================
# LLM_PROVIDER: ollama (local, padrão) | anthropic (API do Claude) | google (API do Gemini)
#
# ATENÇÃO (LGPD): com "anthropic" ou "google", as mensagens dos pacientes são enviadas a um
# serviço externo. Com "ollama", nada sai da máquina. Os embeddings (bge-m3) e o Qdrant
# continuam sempre locais, qualquer que seja o provedor.

# --- Padrão: Llama 3.2 3B local (Ollama) — único avaliado que atinge todas as metas da SPEC ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# --- Llama 3.1 8B local: mais preciso; pede GPU ou ~8 GB de RAM livres ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b

# --- Qwen 2.5 local: 3B tem CHOICE 100%, mas urgência 86% e é mais lento (ADR-12);
#     1.5B é mais leve (~1 GB), não avaliado ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_MODEL=qwen2.5:1.5b

# --- Claude (API Anthropic) — chave em https://console.anthropic.com ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_EFFORT=low          # deixe vazio para modelos Claude sem suporte a effort

# --- Gemini (API Google) — chave em https://aistudio.google.com ---
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=...

# Timeout por chamada ao LLM (s). 120 para CPU; 30 basta com GPU ou API.
LLM_TIMEOUT_S=120

# =====================================================================
# JEV — quem responde aos avaliadores NOUL, CHOICE e SCORE (ADR-14)
# =====================================================================
# auto (padrão): usa o Jev se TYPESAFE_API_KEY estiver definida; senão, o modo local (o LLM acima
#   responde em JSON validado). A escolha aparece no log de inicialização (decision_engine_selected).
# typesafe: exige o Jev — sem chave, o backend não sobe. llm: força o modo local.
# O Jev, modelo de decisões da TypeSafe AI, responde as perguntas de backend/jevs/*.json.
#   Acesso por lista de espera em https://typesafe.ai — requer chave de API.
#   ATENÇÃO (LGPD): com o Jev, as mensagens são enviadas a um serviço externo.
JEV_PROVIDER=auto
# JEV_PROVIDER=typesafe
# JEV_PROVIDER=llm
# TYPESAFE_API_KEY=...
# TYPESAFE_MODEL=jev-1.13.0       # versão fixada; o alias jev-latest muda sem aviso
# JEV_TIMEOUT_S=10
# JEV_NOUL_THRESHOLD=0.5          # bloqueia se P(ofensa) ou P(PII) >= limite
# JEV_URGENCY_THRESHOLD=0.3      # marca urgência se P(urgência) >= limite (menor que o de bloqueio: favorece não deixar passar)
# JEV_MIN_CONFIDENCE=0.5          # SCORE com confiança menor vai para o fallback

# =====================================================================
# Embeddings e busca (sempre locais)
# =====================================================================
EMBED_MODEL=bge-m3
# Endereços para execução LOCAL (fora do Docker).
# No docker-compose, OLLAMA_BASE_URL e QDRANT_URL são sobrescritos com os nomes dos serviços.
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ubs_docs
TOP_K=3
SCORE_THRESHOLD=3
AUTO_INGEST=true

# Encaminhamento e agendamento. false (padrão): a resposta orienta levar o protocolo à recepção.
# true: a resposta diz "aguarde, alguém vai atender você aqui" — só ligue quando existir a
# transferência ao vivo (fila, painel do atendente e mensagens em tempo real). Urgência nunca pede para aguardar.
HANDOFF_LIVE=false

# =====================================================================
# API e interface
# =====================================================================
CORS_ORIGINS=http://localhost:5173

# Modo demonstração: mostra a rota do grafo e a nota do SCORE em cada resposta.
# true = demo/portfólio; false = chat com cara de produto (fontes e selos continuam visíveis).
# Ao mudar, reconstrua o frontend: docker compose up -d --build frontend
SHOW_DEBUG=true
